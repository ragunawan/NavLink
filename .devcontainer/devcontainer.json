{
  "name": "NavyLINK",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=navylink-venv-${devcontainerId},target=${containerWorkspaceFolder}/.venv,type=volume,volume-nocopy",
    "source=navylink-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/frontend/node_modules,type=volume,volume-nocopy",
    "source=navylink-data-${devcontainerId},target=/var/lib/navylink,type=volume"
  ],
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/backend",
    "NAVYLINK_DB": "/var/lib/navylink/navylink.db",
    "WATCHFILES_FORCE_POLLING": "true",
    "CHOKIDAR_USEPOLLING": "true",
    "CHOKIDAR_INTERVAL": "300"
  },
  "forwardPorts": [8000, 5173, 8013],
  "portsAttributes": {
    "8000": {
      "label": "NavyLINK app and API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "NavyLINK Vite frontend",
      "onAutoForward": "notify"
    },
    "8013": {
      "label": "NavyLINK browser test API",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": ["bash", ".devcontainer/post-create.sh"],
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-playwright.playwright"
      ],
      "settings": {
        "files.eol": "\n",
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend/tests"],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
