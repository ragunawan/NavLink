# Paths are relative to the repository root. Run commands from the root.
NAVYLINK_DB=data/navylink.db
NAVYLINK_FRONTEND=frontend/dist
NAVYLINK_SEMANTIC_WEIGHT=0.55
# Optional: prepare the model first; runtime fails clearly if unavailable.
# NAVYLINK_MODEL_PATH=data/models/all-MiniLM-L6-v2
# Optional JSON array of demo identity objects; see README.
# NAVYLINK_DEMO_USERS=data/demo-users.json
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional RAG generation. Core proposal analysis always stays deterministic.
NAVYLINK_LLM_PROVIDER=none
# openai: base URL ending in /v1; ollama: server root, e.g. http://127.0.0.1:11434
# NAVYLINK_LLM_BASE_URL=https://approved-endpoint.example/v1
# NAVYLINK_LLM_MODEL=your-approved-model-name
# NAVYLINK_LLM_API_KEY=
NAVYLINK_LLM_TIMEOUT=5

# Optional bottom-right catalog chatbot.
# Keep the real key only in your local .env, never in Git.
# OPENAI_API_KEY=
OPENAI_CHAT_MODEL=terra-6.1
